@model IdeaDetailViewModel

@{
    ViewData["Title"] = "Fikir Detayı";

    bool hasEvaluatePermission = User.HasClaim("Permission", "Idea.Evaluate");
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card mb-4 shadow-sm border">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-secondary mb-0">@Model.Idea.Title</h4>

                    <span class="badge @Model.Idea.CategoryName.GetCategoryBadgeClass() px-3 py-2 shadow-sm">
                        <i class="fa-solid fa-tag me-1"></i> @Model.Idea.CategoryName
                    </span>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-circle-info text-primary me-2"></i>Açıklama</h6>
                    <p class="card-text text-muted" style="text-align: justify;">@Model.Idea.Description</p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-bullseye text-danger me-2"></i>Hedeflenen Fayda</h6>
                    <p class="card-text text-muted" style="text-align: justify;">@Model.Idea.TargetedBenefit</p>
                </div>

                @if (Model.Idea.Documents != null && Model.Idea.Documents.Any())
                {
                    <div class="mb-3 bg-white p-3 rounded-3 border">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa-solid fa-paperclip text-secondary me-2"></i>Dokümanlar
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var doc in Model.Idea.Documents)
                            {
                                string extension = System.IO.Path.GetExtension(doc.FileName)?.ToLower() ?? "";

                                <a href="@doc.FilePath" target="_blank" class="btn bg-white border btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center text-dark text-decoration-none">
                                    <i class="fa-solid @extension.GetFileIconClass() fs-5 me-2"></i>
                                    <span class="fw-semibold small">@doc.FileName</span>
                                    <i class="fa-solid fa-download ms-2 text-muted" style="font-size: 0.8em;"></i>
                                </a>
                            }
                        </div>
                    </div>
                }

                <hr class="text-muted mb-3" />

                <div class="row text-muted small">
                    <div class="col-md-6 mb-2 mb-md-0">
                        <i class="fa-solid fa-user me-1"></i> <strong>Ekleyen:</strong> @Model.Idea.AddedByUserFirstName @Model.Idea.AddedByUserLastName (@Model.Idea.AddedByUserEmail)
                    </div>
                    <div class="col-md-6 text-md-end">
                        <i class="fa-regular fa-calendar me-1"></i> <strong>Tarih:</strong> @Model.Idea.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        @await Component.InvokeAsync("EvaluationFilterMenu", new { ideaId = Model.Idea.Id })
    </div>

    <div class="col-md-9">

        @if (hasEvaluatePermission)
        {
            <partial name="_EvaluationCreatePartial"
                     model="new EvaluationCreateViewModel { IdeaId = Model.Idea.Id }" />
        }
        else
        {
            <div class="alert alert-secondary shadow-sm mb-4 border-0 border-start border-4 border-secondary" role="alert">
                <i class="fa-solid fa-circle-info me-2"></i> Fikirleri değerlendirmek için gerekli yetkiye sahip değilsiniz.
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-secondary">
                <i class="fa-solid fa-list-check me-2"></i>Değerlendirmeler
            </h5>
        </div>

        @{
            var requestParams = new FikirHavuzu.Entity.RequestParameters.EvaluationRequestParameters
            {
                IdeaId = Model.Idea.Id,
                PageNumber = int.TryParse(Context.Request.Query["pageNumber"], out int p) ? p : 1,
                Score = int.TryParse(Context.Request.Query["Score"], out int s) ? s : null,
                IsApproved = bool.TryParse(Context.Request.Query["IsApproved"], out bool isApp) ? isApp : null,
                Comment = Context.Request.Query["Comment"],
                FullName = Context.Request.Query["FullName"],
                StartDate = DateTime.TryParse(Context.Request.Query["StartDate"], out DateTime sd) ? sd : null,
                EndDate = DateTime.TryParse(Context.Request.Query["EndDate"], out DateTime ed) ? ed : null
            };
        }

        <div id="evaluation-list-container"
             hx-get="@Url.Action("Detail", "Idea", new { id = Model.Idea.Id })"
             hx-trigger="refreshEvaluations from:body"
             hx-swap="innerHTML">
            @await Component.InvokeAsync("EvaluationList", new { parameters = requestParams })
        </div>
    </div>
</div>
