@model IdeaListViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    bool hasCreatePermission = User.HasClaim("Permission", "Idea.Create");
}

<div class="row">
    <div class="col-12">
        <div class="my-3 p-3 bg-white rounded-3 shadow-sm border container-fluid text-center">
            <h1 class="text-primary fw-bold">
                <i class="fa-solid fa-lightbulb text-warning"></i>
                Fikir Havuzuna Hoş Geldiniz
            </h1>
            <p class="text-muted">
                Şirketimizin süreçlerini iyileştirmek, yeni ürün ve hizmet fikirleri geliştirmek için önerilerinizi bekliyoruz.
                Aşağıdan mevcut fikirleri inceleyebilir veya kendi fikrinizi paylaşarak sürece katkıda bulunabilirsiniz.
            </p>
        </div>
    </div>
</div>


        
    
<div class="row">
    <div class="col-md-3">
        @await Component.InvokeAsync("IdeaFilterMenu")
    </div>

    <div class="col-md-9">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-secondary">
                <i class="fa-solid fa-list"></i>
                Fikir Listesi
            </h5>
            @if (hasCreatePermission)
            {
                <a asp-controller="Idea" asp-action="Create" class="btn btn-outline-success btn-sm fw-bold shadow-sm">
                    <i class="fa-solid fa-plus"></i> Yeni Fikir Ekle
                </a>
            }
        </div>

        <div class="row g-3">

            @if (Model.Ideas != null && Model.Ideas.Any())
            {
                @foreach (var idea in Model.Ideas)
                {
                    <partial name="_IdeaCard" model="@idea" />
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center py-4 shadow-sm">
                        <i class="fa-solid fa-circle-info me-2"></i> Sistemde henüz kayıtlı bir fikir bulunmuyor veya aramanıza uygun sonuç çıkmadı.
                    </div>
                </div>
            }

        </div>

        <div class="d-flex justify-content-center my-5">
            <div page-model="@Model?.Pagination"
                    page-action="Index"
                    page-classes-enabled="true"
                    page-class="btn shadow-sm"
                    page-class-normal="btn-outline-primary"
                    page-class-selected="btn-primary"
                    class="btn-group">
            </div>
        </div>
    </div>
</div>   