@model UserPermissionAssignmentViewModel

@{
    ViewData["Title"] = "Kullanıcı Yetkilendirme";
}

<div class="container my-3">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0 text-primary">Yetki Yönetimi: @Model.FirstName @Model.LastName</h4>

                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Aktif Kullanıcı</span>
                }
                else
                {
                    <span class="badge bg-danger">Pasif Kullanıcı</span>
                }
            </div>
            <p class="text-muted mt-1 mb-0">@Model.Email | T.C.: @Model.IdentityNumber</p>
        </div>
        <div class="card-body">

            <form asp-controller="User" asp-action="ManagePermissions" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold" role="alert"></div>

                <input type="hidden" asp-for="Id" />


                @await Component.InvokeAsync("UserPermissionList", new { selectedIds = Model.SelectedPermissionIds })

                <hr class="text-muted opacity-25 my-3"/>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-danger me-md-2">Vazgeç</a>
                    <button type="submit" class="btn btn-outline-primary">Yetkileri Kaydet</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/permission-dependency.js"></script>
}