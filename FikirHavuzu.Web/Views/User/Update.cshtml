@model UserUpdateViewModel

@{
    ViewData["Title"] = "Kullanıcı Güncelle";
}

<div class="container my-3">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h4 class="mb-0 text-primary">Kullanıcı Bilgilerini Güncelle</h4>
        </div>
        <div class="card-body">
            <form asp-controller="User" asp-action="Update" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold" role="alert"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 my-3">
                        <label asp-for="FirstName" class="form-label fw-bold">Ad</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Kullanıcının adını giriniz..." />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 my-3">
                        <label asp-for="LastName" class="form-label fw-bold">Soyad</label>
                        <input asp-for="LastName" class="form-control" placeholder="Kullanıcının soyadını giriniz..." />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 my-3">
                        <label asp-for="IdentityNumber" class="form-label fw-bold">T.C. Kimlik Numarası</label>
                        <input asp-for="IdentityNumber" class="form-control" placeholder="11 haneli T.C. kimlik numarası..." maxlength="11" />
                        <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 my-3">
                        <label asp-for="RegistrationNumber" class="form-label fw-bold">Kurum Sicil Numarası</label>
                        <input asp-for="RegistrationNumber" class="form-control" placeholder="Örn: 104523" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 my-3">
                        <label asp-for="Email" class="form-label fw-bold">E-posta</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="ornek@sirket.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 my-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Telefon (İsteğe Bağlı)</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="05XX XXX XX XX" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 my-3">
                        <label asp-for="Password" class="form-label fw-bold">Yeni Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın..." />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 my-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Yeni şifrenizi doğrulayın..." />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col my-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                            <label class="form-check-label fw-bold text-success" for="isActiveSwitch">Hesap Aktif (Kullanıcı giriş yapabilir)</label>
                        </div>
                    </div>
                </div>

                <hr class="text-muted opacity-25" />

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-danger me-md-2">İptal</a>
                    <button type="submit" class="btn btn-outline-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}