@model IdeaDto

<div class="col-md-6 col-xl-4">
    <div class="card shadow-sm border border-light-subtle bg-white d-flex flex-column" style="height: 280px;">

        <div class="card-body flex-grow-1 d-flex flex-column">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge @Model.CategoryName.GetCategoryBadgeClass() px-3 py-2">@Model.CategoryName</span>

                <small class="text-muted">
                    <i class="fa-regular fa-calendar me-1"></i>@Model.CreatedAt.ToString("dd.MM.yyyy")
                </small>
            </div>

            <h6 class="card-title fw-bold text-dark mb-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                @Model.Title
            </h6>

            <p class="text-success small fw-semibold mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <i class="fa-solid fa-bullseye me-1"></i>@Model.TargetedBenefit
            </p>

            <p class="card-text text-secondary small mb-0" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                @Model.Description
            </p>

        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center pb-3 pt-0 mt-auto">
            <div class="overflow-hidden me-2" style="max-width: 65%;">
                <small class="text-dark fw-semibold d-block text-truncate" title="@Model.AddedByUserFirstName @Model.AddedByUserLastName">
                    <i class="fa-regular fa-user me-1 text-primary"></i>@Model.AddedByUserFirstName @Model.AddedByUserLastName
                </small>
                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;" title="@Model.AddedByUserEmail">
                    <i class="fa-regular fa-envelope me-1"></i>@Model.AddedByUserEmail
                </small>
            </div>

            <a asp-controller="Idea" asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary text-nowrap">
                Detay <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

    </div>
</div>