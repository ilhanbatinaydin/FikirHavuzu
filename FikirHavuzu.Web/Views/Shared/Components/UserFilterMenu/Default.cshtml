@model UserFilterViewModel

<div class="p-3 bg-white rounded-3 shadow-sm border">
    <h5 class="fw-bold text-primary border-bottom pb-3">
        <i class="fa-solid fa-filter"></i>
        Filtreler
    </h5>

    <form method="get" asp-controller="User" asp-action="Index">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label text-muted small fw-bold">Ad Soyad</label>
            <input type="text" asp-for="FullName" class="form-control form-control-sm" placeholder="Ad Soyad ..." />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-muted small fw-bold">E-Mail</label>
            <input type="text" asp-for="Email" class="form-control form-control-sm" placeholder="E-Mail ..." />
        </div>

        <div class="mb-3">
            <label asp-for="IdentityNumber" class="form-label text-muted small fw-bold">T.C.</label>
            <input type="text" asp-for="IdentityNumber" class="form-control form-control-sm" placeholder="T.C. ..." />
        </div>

        <div class="mb-3">
            <label asp-for="PermissionId" class="form-label text-muted small fw-bold">Yetkiler</label>
            <select asp-for="PermissionId" class="form-select form-select-sm" asp-items="Model.PermissionList">
                <option value="">Tümü</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="IsActive" class="form-label text-muted small fw-bold">Durum</label>
            <select asp-for="IsActive" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="true">Aktif</option>
                <option value="false">Pasif</option>
            </select>
        </div>

        <div class="d-grid gap-2">
            <button type="button"
                    hx-get="@Url.Action("Index", "User")"
                    hx-include="closest form"
                    hx-target="#user-list-container"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    class="btn btn-outline-primary btn-sm fw-bold">
                    Uygula
            </button>

            <a hx-get="@Url.Action("Index", "User")"
               hx-target="#user-list-container"
               hx-swap="innerHTML"
               hx-push-url="true"
               onclick="clearFilterForm(this)"
               class="btn btn-outline-danger btn-sm">
               Sıfırla
           </a>
        </div>
    </form>
</div>