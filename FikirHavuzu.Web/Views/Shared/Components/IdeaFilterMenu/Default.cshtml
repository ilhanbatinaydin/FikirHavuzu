@model IdeaFilterViewModel

<div class="p-3 bg-white rounded-3 shadow-sm border">
    <h5 class="fw-bold text-primary border-bottom pb-3">
        <i class="fa-solid fa-filter"></i>
        Filtreler
    </h5>

    <form method="get" asp-controller="Home" asp-action="Index">
        <div class="mb-3">
            <label asp-for="SearchQuery" class="form-label text-muted small fw-bold">Arama</label>
            <input type="text" asp-for="SearchQuery" class="form-control form-control-sm" placeholder="Fikir içeriği ..." />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label text-muted small fw-bold">Kategori</label>
            <select asp-for="CategoryId" class="form-select form-select-sm" asp-items="Model.CategoryList">
                <option value="">Tümü</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label text-muted small fw-bold">Başlangıç Tarihi</label>
            <input type="date" asp-for="StartDate" class="form-control form-control-sm" />
        </div>

        <div class="mb-3">
            <label asp-for="EndDate" class="form-label text-muted small fw-bold">Bitiş Tarihi</label>
            <input type="date" asp-for="EndDate" class="form-control form-control-sm" />
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label text-muted small fw-bold">Ekleyen Kişi</label>
            <input type="text" asp-for="FullName" class="form-control form-control-sm" placeholder="Ad soyad ...">
        </div>

        <div class="d-grid gap-2">
            <button type="button"
                    hx-get="@Url.Action("Index", "Home")"
                    hx-include="closest form"
                    hx-target="#idea-list-container"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    class="btn btn-outline-primary btn-sm fw-bold">
                    Uygula
            </button>
            <a hx-get="@Url.Action("Index", "Home")"
               hx-target="#idea-list-container"
               hx-swap="innerHTML"
               hx-push-url="true"
               onclick="clearFilterForm(this)"
               class="btn btn-outline-danger btn-sm">
               Sıfırla
           </a>
        </div>
    </form>
</div>