@model IEnumerable<CategoryDto>

<div class="p-3 bg-white rounded-3 shadow-sm border">
    <h5 class="fw-bold text-primary border-bottom pb-3">
        <i class="fa-solid fa-filter"></i>
        Filtreler
    </h5>

    <form method="get" asp-controller="Home" asp-action="Index">
        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Arama</label>
            <input type="text" name="searchQuery" value="@Context.Request.Query["searchQuery"]" class="form-control form-control-sm" placeholder="Fikir içeriği..." />
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Kategori</label>
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">Tümü</option>
                @foreach (CategoryDto category in Model)
                {
                    if (Context.Request.Query["categoryId"] == category.Id.ToString())
                    {
                        <option value="@category.Id" selected>@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Tarih</label>
            <input type="date" name="filterDate" value="@Context.Request.Query["filterDate"]" class="form-control form-control-sm text-muted">
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Ekleyen Kişi</label>
            <input type="text" name="fullName" value="@Context.Request.Query["fullName"]" class="form-control form-control-sm" placeholder="Ad soyad...">
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-outline-primary btn-sm fw-bold">Uygula</button>
            <a href="/Home/Index" class="btn btn-outline-danger btn-sm">Sıfırla</a>
        </div>
    </form>
</div>