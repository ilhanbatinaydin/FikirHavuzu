@model EvaluationListViewModel

<div class="row g-3">
    @if (Model.Evaluations != null && Model.Evaluations.Any())
    {
        @foreach (var eval in Model.Evaluations)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 border-start border-4 @(eval.IsApproved ? "border-success" : "border-danger")">
                    <div class="card-body">
                        <div class="row align-items-center">

                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light text-secondary rounded-circle d-flex align-items-center justify-content-center me-3 border" style="width: 50px; height: 50px;">
                                        <i class="fa-solid fa-user fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1">@eval.EvaluatorFullName</h6>
                                        <small class="text-muted d-block mb-1">@eval.EvaluatorEmail</small>
                                        <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i> @eval.EvaluationDate.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3 mb-md-0">
                                @{
                                    var comment = eval.Comment ?? "";
                                    int maxLength = 130;
                                }

                                @if (comment.Length > maxLength)
                                {
                                    var uniqueId = Guid.NewGuid().ToString("N");
                                    var shortText = comment.Substring(0, maxLength) + "...";

                                    <div>
                                        <div id="short-@uniqueId">
                                            <p class="mb-0 text-muted fst-italic">
                                                "@shortText"
                                                <a href="#full-@uniqueId" data-bs-toggle="collapse"
                                                   onclick="document.getElementById('short-@uniqueId').classList.add('d-none');"
                                                   class="text-decoration-none small text-primary fw-bold ms-1">
                                                    Devamını Oku <i class="fa-solid fa-angle-down"></i>
                                                </a>
                                            </p>
                                        </div>

                                        <div class="collapse" id="full-@uniqueId">
                                            <p class="mb-0 text-muted fst-italic">
                                                "@comment"
                                                <a href="#full-@uniqueId" data-bs-toggle="collapse"
                                                   onclick="document.getElementById('short-@uniqueId').classList.remove('d-none');"
                                                   class="text-decoration-none small text-danger fw-bold ms-1">
                                                    Gizle <i class="fa-solid fa-angle-up"></i>
                                                </a>
                                            </p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted fst-italic">"@comment"</p>
                                }
                            </div>

                            <div class="col-md-2 text-md-end">
                                <div class="mb-2">
                                    <span class="badge bg-warning text-dark border border-warning rounded-pill">
                                        <i class="fa-solid fa-star"></i> Puan: @eval.Score / 5
                                    </span>
                                </div>
                                <div>
                                    @if (eval.IsApproved)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">
                                            <i class="fa-solid fa-check"></i> Onaylı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill">
                                            <i class="fa-solid fa-xmark"></i> Ret
                                        </span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-4 shadow-sm border-0">
                <i class="fa-solid fa-circle-info me-2"></i> Bu fikir için henüz bir değerlendirme yapılmamış veya aramanıza uygun sonuç çıkmadı.
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-center my-5">
    <div page-model="@Model?.Pagination"
         page-action="Detail"
         page-classes-enabled="true"
         page-class="btn shadow-sm"
         page-class-normal="btn-outline-primary"
         page-class-selected="btn-primary"
         class="btn-group">
    </div>
</div>