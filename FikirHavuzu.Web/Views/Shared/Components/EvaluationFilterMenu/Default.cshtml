@model EvaluationFilterViewModel

<div class="p-3 bg-white rounded-3 shadow-sm border">
    <h5 class="fw-bold text-primary border-bottom pb-3">
        <i class="fa-solid fa-filter"></i>
        Filtreler
    </h5>

    <form method="get" asp-controller="Idea" asp-action="Detail" asp-route-id="@Model.IdeaId">

        <div class="mb-3">
            <label asp-for="FullName" class="form-label text-muted small fw-bold">Değerlendiren</label>
            <input type="text" asp-for="FullName" class="form-control form-control-sm" placeholder="Ad Soyad ..." />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-muted small fw-bold">Değerlendiren (E-Mail)</label>
            <input type="text" asp-for="Email" class="form-control form-control-sm" placeholder="E-Mail ..." />
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label text-muted small fw-bold">İçerik</label>
            <input type="text" asp-for="Comment" class="form-control form-control-sm" placeholder="Yorumlarda ara ..." />
        </div>

        <div class="mb-3">
            <label asp-for="Score" class="form-label text-muted small fw-bold">Net Puan</label>
            <input type="number" asp-for="Score" class="form-control form-control-sm" placeholder="Örn: 5" min="1" max="5" />
        </div>

        <div class="mb-3">
            <label asp-for="IsApproved" class="form-label text-muted small fw-bold">Durum</label>
            <select asp-for="IsApproved" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="true">Onaylı</option>
                <option value="false">Ret</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label text-muted small fw-bold">Başlangıç Tarihi</label>
            <input type="date" asp-for="StartDate" class="form-control form-control-sm" />
        </div>

        <div class="mb-3">
            <label asp-for="EndDate" class="form-label text-muted small fw-bold">Bitiş Tarihi</label>
            <input type="date" asp-for="EndDate" class="form-control form-control-sm" />
        </div>

        <div class="d-grid gap-2">
            <button type="button"
                    hx-get="@Url.Action("Detail", "Idea", new { id = Model.IdeaId })"
                    hx-include="closest form"
                    hx-target="#evaluation-list-container"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    class="btn btn-outline-primary btn-sm fw-bold">
                    Uygula
            </button>

            <a hx-get="@Url.Action("Detail", "Idea", new { id = Model.IdeaId })"
               hx-target="#evaluation-list-container"
               hx-swap="innerHTML"
               hx-push-url="true"
               onclick="clearFilterForm(this)"
               class="btn btn-outline-danger btn-sm">
               Sıfırla
            </a>
        </div>
    </form>
</div>