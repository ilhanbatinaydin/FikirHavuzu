@model EvaluationDto

<div class="col-12">
    <div class="card shadow-sm border-0 border-start border-4 @(Model.IsApproved ? "border-success" : "border-danger")">
        <div class="card-body">
            <div class="row align-items-center">

                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3 border shadow-sm" style="width: 50px; height: 50px; min-width: 50px;">
                            <i class="fa-solid fa-lightbulb fs-4 text-warning"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="mb-1">
                                <span class="badge @Model.CategoryName.GetCategoryBadgeClass() px-2 py-1" style="font-size: 0.75rem;">
                                    @Model.CategoryName
                                </span>
                            </div>
                            <a asp-controller="Idea" asp-action="Detail" asp-route-id="@Model.IdeaId"
                               class="text-dark fw-bold text-decoration-none d-block text-truncate mb-1"
                               title="@Model.IdeaTitle">
                                @Model.IdeaTitle
                            </a>
                            <small class="text-muted d-block">
                                <i class="fa-regular fa-calendar me-1"></i>@Model.EvaluationDate.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3 mb-md-0">
                    @{
                        var comment = Model.Comment ?? "";
                        int maxLength = 120;
                    }

                    @if (comment.Length > maxLength)
                    {
                        var shortText = comment.Substring(0, maxLength) + "...";

                        <div>
                            <div id="short-@Model.Id">
                                <p class="mb-0 text-muted fst-italic">
                                    "@shortText"
                                    <a href="#full-@Model.Id" data-bs-toggle="collapse"
                                       onclick="document.getElementById('short-@Model.Id').classList.add('d-none');"
                                       class="text-decoration-none small text-primary fw-bold ms-1">
                                        Devamını Oku <i class="fa-solid fa-angle-down"></i>
                                    </a>
                                </p>
                            </div>

                            <div class="collapse" id="full-@Model.Id">
                                <p class="mb-0 text-muted fst-italic">
                                    "@comment"
                                    <a href="#full-@Model.Id" data-bs-toggle="collapse"
                                       onclick="document.getElementById('short-@Model.Id').classList.remove('d-none');"
                                       class="text-decoration-none small text-danger fw-bold ms-1">
                                        Gizle <i class="fa-solid fa-angle-up"></i>
                                    </a>
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 text-muted fst-italic">"@comment"</p>
                    }
                </div>

                <div class="col-md-2 text-md-end">
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark border border-warning rounded-pill">
                            <i class="fa-solid fa-star"></i> Puan: @Model.Score / 5
                        </span>
                    </div>
                    <div>
                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">
                                <i class="fa-solid fa-check"></i> Onaylı
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill">
                                <i class="fa-solid fa-xmark"></i> Ret
                            </span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>