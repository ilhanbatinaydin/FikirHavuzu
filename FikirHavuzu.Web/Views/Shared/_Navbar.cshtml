<nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary border-bottom">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fa-solid fa-lightbulb fa-2x text-secondary"></i>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="navbarNavAltMarkup">

            <ul class="navbar-nav flex-grow-1">

                <li class="nav-item">
                    <a class="nav-link" aria-current="page" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                </li>

                @if (User.Identity.IsAuthenticated && User.HasClaim("Permission", "User.Manage"))
                {
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page" asp-controller="User" asp-action="Index">Kullanıcı Yönetimi</a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
                    var lastName = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value;
                    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-circle-user fa-xl me-2 text-primary"></i>
                            <span class="fw-medium">@firstName @lastName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" aria-labelledby="userProfileDropdown">
                            <li class="px-3 py-2 text-center border-bottom mb-1">
                                <span class="d-block fw-bold text-dark">@firstName @lastName</span>
                                <small class="text-muted">@email</small>
                            </li>

                            <li>
                                <a class="dropdown-item d-flex align-items-center py-2" asp-controller="User" asp-action="Profile" asp-route-id="@userId">
                                    <i class="fa-solid fa-id-card text-primary me-2"></i>
                                    Profilim
                                </a>
                            </li>

                            <li><hr class="dropdown-divider m-0"></li>

                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center py-2">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>
                                        Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page" asp-controller="Auth" asp-action="Login">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            Giriş Yap
                        </a>
                    </li>
                }
            </ul>

        </div>
    </div>
</nav>

