        <div class="text-center alert alert-danger border-danger p-5 shadow-sm rounded-4" role="alert">
            <h1 class="fw-bold mb-4">
                <i class="fa-solid fa-shield-halved fs-1 text-danger"></i>
                <br />
                Erişim Reddedildi
